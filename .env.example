# Środowisko lokalne. Skopiuj do .env i ustaw własne hasła.
POSTGRES_DB=foundly
POSTGRES_USER=foundly
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432
KEYCLOAK_DB_PASSWORD=keycloak_local_only
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_only
EMBEDDING_BASE_URL=http://localhost:8000
EMBEDDING_CONNECT_TIMEOUT=2s
EMBEDDING_READ_TIMEOUT=30s
MATCHING_LEASE_DURATION=2m
MATCHING_ENABLED=true
MATCHING_POLL_INTERVAL=1s
MATCHING_RETRY_DELAY=5s
MATCHING_MAX_ATTEMPTS=5
